{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaliPet",
  "version": "0.1.0",
  "identifier": "com.swiftpenguin578.malipet",
  "build": { "beforeBuildCommand": "pnpm build", "beforeDevCommand": "pnpm dev", "frontendDist": "../dist", "devUrl": "http://127.0.0.1:1420" },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "pet", "title": "MaliPet", "width": 280, "height": 220,
      "transparent": true, "decorations": false, "shadow": false,
      "alwaysOnTop": true, "skipTaskbar": true, "resizable": false,
      "focus": false, "focusable": false, "visible": false,
      "acceptFirstMouse": true, "backgroundThrottling": "disabled"
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "shortDescription": "A little black cat for your desktop", "macOS": { "minimumSystemVersion": "11.0" }, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
